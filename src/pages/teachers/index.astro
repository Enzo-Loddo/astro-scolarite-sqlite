---
import Layout from "../../layouts/Layout.astro";
import db from "../../lib/db";
const rows=db.prepare("SELECT first_name,last_name,email FROM teachers ORDER BY last_name,first_name").all();
---
<Layout title="Professeurs"><h1>Professeurs</h1><table><thead><tr><th>Prénom</th><th>Nom</th><th>Email</th></tr></thead><tbody>{rows.map(t=><tr><td>{t.first_name}</td><td>{t.last_name}</td><td>{t.email}</td></tr>)}</tbody></table></Layout>